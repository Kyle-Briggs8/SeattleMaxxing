# Copy to .env for local runs (python-dotenv loads it). In GitHub Actions these
# are provided as repository secrets, not from a file.

# Google Gemini API key — https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=your_gemini_key_here

# Resend API key — https://resend.com/api-keys  (free tier, 3000 emails/mo)
RESEND_API_KEY=your_resend_key_here

# Ticketmaster Discovery API key (OPTIONAL but recommended for music/arts/sports)
# Free: https://developer.ticketmaster.com/  → create an app → Consumer Key.
# Leave blank to disable that source.
TICKETMASTER_API_KEY=your_ticketmaster_key_here

# Where the digest is sent.
EMAIL_TO=you@example.com

# Sender. Must be a Resend-verified domain, OR use the test sender below.
EMAIL_FROM=Seattle Digest <onboarding@resend.dev>
